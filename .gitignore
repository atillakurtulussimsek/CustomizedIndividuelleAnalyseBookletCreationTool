# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual Environment ──────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Distribution / Packaging ─────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── IDE / Editor ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# ── Student PDFs (private data — do NOT commit) ─────────────
input_pdfs/*.pdf
!input_pdfs/front.pdf
!input_pdfs/back.pdf

# ── Output (generated files) ────────────────────────────────
output_pdfs/*.pdf

# ── Logs ─────────────────────────────────────────────────────
logs/*.log
logs/*.csv

# ── Fonts (system-dependent, user-provided) ─────────────────
fonts/*.ttf
fonts/*.otf

# ── OS Generated ────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Test / Coverage ─────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*
.tox/
.nox/
